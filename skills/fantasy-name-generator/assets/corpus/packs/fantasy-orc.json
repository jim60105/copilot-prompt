{
 "id": "fantasy-orc",
 "region": "奇幻",
 "era": "獸人",
 "label": "奇幻‧獸人／半獸人",
 "note": "適用於高奇幻／TRPG 場景的獸人（含半獸人）角色命名，全數為原創構詞組合。",
 "corpus_note": "音韻風格參考主流奇幻作品對「獸人語」的一貫塑造規律：短促喉音和塞音密集（k、g、th、gr、kr、zh 等）、單音節詞根為主、避免流音和開放母音，予人粗獷、兇悍、非人化的聽感。語意場集中於「戰鬥」「傷害」「野性生物」「地形」等具體意象，鮮少抽象詞根，反映部落口語文化而非典雅書面語。全部詞根和最終名字均為本包原創組合，未收錄任何既有奇幻作品（如 D&D 官方設定、《魔戒》半獸人）之角色專有名字，並已核對常見獸人角色名稱清單排除巧合重複。氏族名沿用同一意象系統（身體特徵／戰鬥意象複合詞，如「血牙」「碎顱」），同為原創。",
 "license": "https://creativecommons.org/licenses/by/4.0/",
 "license_note": "語料整理自公開統計和文獻，本站的涵義標注、時代分包和編輯著作採 CC BY 4.0 授權，引用請註明出處。",
 "rules": {
  "naming": {
   "note": "獸人社會以部落／氏族為單位而非個體血緣姓氏，「氏族名」代表所屬部落圖騰或該部落引以為傲的戰績意象，個人需透過戰鬥或狩獵功勳取得使用資格，未立功者僅稱本名。半獸人（人類與獸人混血）常同時保留獸人本名與人類社群給予的稱呼，視所處社群而定。"
  }
 },
